# API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/gmart

# Serve frontend build from backend (optional)
SERVE_FRONTEND=false
NODE_ENV=development

# Upload storage (set this to a persistent disk path in production)
UPLOADS_DIR=

# Optional: Cloudinary image storage (recommended in production)
# When these are set, product images are uploaded to Cloudinary
# and no longer depend on local server disk persistence.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Centralized admin payment recipient used at checkout
ADMIN_PAYMENT_TELEBIRR_PHONE=
ADMIN_PAYMENT_BANK_NAME=
ADMIN_PAYMENT_BANK_ACCOUNT_NUMBER=
ADMIN_PAYMENT_BANK_ACCOUNT_NAME=

# Auth (later)
# Access token
JWT_ACCESS_SECRET=change-me-access
ACCESS_TOKEN_TTL=15m

# Refresh token
JWT_REFRESH_SECRET=change-me-refresh
REFRESH_TOKEN_TTL=30d
